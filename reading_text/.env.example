# Application
APP_NAME=ai-speech-platform
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8100
API_V1_PREFIX=/api/v1

# Security — set in production
API_KEY=

# Storage (Milestone 2)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./output
STORAGE_PUBLIC_BASE_URL=http://localhost:8100/files

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=speech-audio
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1

# AWS S3 (optional — set STORAGE_BACKEND=s3)
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_PUBLIC_URL=

# Redis cache (Milestone 8)
REDIS_URL=redis://localhost:6379/0

# Default alignment (Milestone 4)
ALIGNMENT_ENABLED=true
DEFAULT_ALIGNMENT_PROVIDER=faster-whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Default TTS
DEFAULT_TTS_PROVIDER=edge
DEFAULT_TTS_VOICE=en-US-AriaNeural

# Provider API keys (Milestone 7+)
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# OPENAI_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
