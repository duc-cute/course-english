DB_USER=root
DB_PASS=123456

# JWT (Base64, decode >= 32 bytes for HS256)
JWT_SECRET=Y291cnNlZW5nbGlzaGp3dHNlY3JldGtleTEyMzQ1Njc4OTA=
JWT_ACCESS_TOKEN_VALIDITY=3600
JWT_REFRESH_TOKEN_VALIDITY=86400

# Storage
STORAGE_LOCATION=C:/DucNguyen/course-english-storage
STORAGE_MAX_FILE_SIZE=10MB
UPLOAD_FILE_BASE_URI=file:///C:/DucNguyen/course-english-storage/
#mail
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=ducnguyen150120035555@gmail.com
MAIL_PASS=hihi
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=Course English <noreply@courseenglish.local>
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# URL API public — dùng khi deploy/ngrok để ảnh /storage/** hiển thị trong email
API_PUBLIC_BASE_URL=https://api.your-domain.com

# Redis (Phase 3 — lesson detail cache)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=ce:
REDIS_LESSON_DETAIL_TTL_SECONDS=43200
REDIS_NULL_CACHE_TTL_SECONDS=120
REDIS_LOCK_TTL_SECONDS=10
REDIS_TTL_JITTER_RATIO=0.2

# Google Sign-In (OAuth 2.0 Web client ID — cùng giá trị VITE_GOOGLE_CLIENT_ID ở FE)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI Assistant (OpenRouter — Phase 1)
# Lấy key tại https://openrouter.ai/keys
AI_ENABLED=true
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_X_TITLE=Course English LMS
AI_DEFAULT_CHAT_MODEL=google/gemini-2.0-flash-001
AI_DAILY_REQUEST_LIMIT=50
AI_MAX_CONTEXT_MESSAGES=20
AI_REQUEST_TIMEOUT_SEC=120
AI_LOG_REQUESTS=true
# System prompt — dùng \\n để xuống dòng. Để trống = prompt mặc định trong code.
AI_SYSTEM_PROMPT=Bạn là LinguistAI — trợ lý học tiếng Anh của Course English.\\n\\nPHONG CÁCH XƯNG HÔ (bắt buộc):\\n- Luôn xưng "em" với người dùng.\\n- Gọi người dùng là "cô" (mặc định; hệ thống không có thông tin giới tính). Có thể thêm tên riêng nếu biết từ tin nhắn hoặc ngữ cảnh. Không dùng "cô/anh" hay "anh".\\n- Giọng lịch sự, ấm áp, hơi vui; có thể khen nhẹ nhàng khi phù hợp (vd: "Dạ có ngay cho cô Mi xinh đẹp và siêu tinh tế đây ạ!").\\n- Mở đầu/xác nhận có thể dùng: "Dạ có ngay ạ!", "Dạ em hiểu ạ".\\n- Không lạm dụng khen; ưu tiên nội dung học tiếng Anh.\\n\\nNỘI DUNG:\\n- Trả lời rõ ràng, thực tế; không bịa thông tin bài học.\\n- Trả lời tiếng Việt nếu user viết tiếng Việt; tiếng Anh nếu user viết tiếng Anh.